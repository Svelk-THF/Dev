---
import { SECTORS, BENEFICIARIES } from "../data/taxonomy";

interface Props {
  // Only show options that at least one listing actually uses
  sectorsInUse: Set<string>;
  beneficiariesInUse: Set<string>;
}

const { sectorsInUse, beneficiariesInUse } = Astro.props;
const sectors = Object.entries(SECTORS).filter(([key]) =>
  sectorsInUse.has(key),
);
const beneficiaries = Object.entries(BENEFICIARIES).filter(([key]) =>
  beneficiariesInUse.has(key),
);
---

<!-- Hidden until JS runs: without JS, visitors simply see the full list. -->
<form class="filters" id="filters" hidden aria-label="Filter nonprofits">
  <div class="filters__search">
    <label for="q">Search by name</label>
    <input id="q" name="q" type="search" autocomplete="off" />
  </div>

  <fieldset>
    <legend>Sector</legend>
    <div class="chips">
      {
        sectors.map(([key, label]) => (
          <label class="chip">
            <input type="checkbox" name="sector" value={key} />
            <span>{label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset>
    <legend>Who you can help</legend>
    <div class="chips">
      {
        beneficiaries.map(([key, label]) => (
          <label class="chip chip--beneficiaries">
            <input type="checkbox" name="beneficiaries" value={key} />
            <span>{label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="filters__footer">
    <p id="result-count" role="status" aria-live="polite"></p>
    <div class="filters__actions">
      <button type="reset" class="link-button">Clear filters</button>
      <button type="button" class="shuffle-button" id="shuffle">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M16 3h5v5"></path><path d="M4 20 21 3"></path><path
            d="M21 16v5h-5"></path><path d="m15 15 6 6"></path><path
            d="M4 4l5 5"></path></svg
        >
        Shuffle
      </button>
      <div class="view-toggle" role="group" aria-label="Layout">
        <button type="button" data-view="grid" aria-pressed="true">Grid</button>
        <button type="button" data-view="list" aria-pressed="false">List</button
        >
      </div>
    </div>
  </div>
</form>

<style>
  .filters {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--space-3xs);
    padding: var(--space-s);
    display: grid;
    gap: var(--space-s);
    margin-block: var(--space-m);
  }
  .filters[hidden] {
    display: none;
  }
  .filters__search {
    display: grid;
    gap: Var(--space-3xs);
    max-width: 65ch;
  }
  label[for="q"],
  legend {
    font-weight: 700;
    font-size: var(--font-size--1);
    text-transform: uppercase;
  }
  input[type="search"] {
    font: inherit;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--space-3xs);
    background: var(--bg);
    color: var(--text);
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  legend {
    margin-bottom: var(--space-2xs);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap:var(--space-2xs);
  }
  .chip {
    position: relative;
  }
  /* Keep the real checkbox in the accessibility tree; style the span as the chip */
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-block;
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: var(--font-size--2);
    cursor: pointer;
    user-select: none;
  }
  .chip input:checked + span {
    background: #fdf6ec;
    color: var(--body);
    border-color: var(--accent-contrast);
    font-weight: 600;
  }
  .chip--beneficiaries input:checked + span {
    background: #e7f1f0;
    color: var(--body);
    border-color: var(--accent);
  }
  .chip input:checked + span::before {
    content: "✓ ";
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .filters__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-xs);
    border-top: 1px solid var(--border);
    padding-top: var(--space-s);
  }
  #result-count {
    margin: 0;
    color: var(--muted);
  }
  .filters__actions {
    display: flex;
    gap: var(--space-s);
    align-items: flex-end;
  }
  button {
    font: inherit;
    cursor: pointer;
  }
  .link-button {
    background: none;
    border: 0;
    color: var(--accent);
    text-decoration: underline;
    padding: 0.25rem;
    font-size: var(--font-size--2);
  }
  .shuffle-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    background: white;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--space-3xs);
    padding: 0.375rem 0.875rem;
    font-size: var(--font-size--2);
  }
  .shuffle-button:hover {
    border-color: var(--accent);
  }
  .view-toggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: var(--space-3xs);
    overflow: hidden;
  }
  .view-toggle button {
    background: var(--surface);
    color: var(--text);
    border: 0;
    padding: 0.375rem 0.875rem;
    font-size: var(--font-size--2);
  }
  .view-toggle button[aria-pressed="true"] {
    background: var(--accent);
    color: var(--surface);
  }
</style>

<script>
  import { shuffle } from "../lib/shuffle";

  const form = document.querySelector<HTMLFormElement>("#filters");
  const results = document.querySelector<HTMLElement>(".results");
  const countEl = document.querySelector<HTMLElement>("#result-count");
  const emptyEl = document.querySelector<HTMLElement>("#no-results");

  if (form && results && countEl) {
    const cards = Array.from(results.querySelectorAll<HTMLElement>(".card"));
    const total = cards.length;
    form.hidden = false;

    // Re-order the actual DOM nodes (not just CSS `order`) so keyboard and
    // screen-reader order always matches what's on screen.
    const reorder = () => results.append(...shuffle(cards));
    reorder(); // fresh random order on every visit

    let summary = "";
    form.querySelector("#shuffle")?.addEventListener("click", () => {
      reorder();
      // Clear then set, so screen readers announce it even on repeat clicks
      countEl.textContent = "";
      requestAnimationFrame(
        () => (countEl.textContent = `Order shuffled. ${summary}`),
      );
    });

    const checked = (name: string) =>
      Array.from(
        form.querySelectorAll<HTMLInputElement>(
          `input[name="${name}"]:checked`,
        ),
      ).map((i) => i.value);

    // Within a group: match ANY selected option. Across groups: must match ALL groups.
    const apply = () => {
      const q = (form.querySelector<HTMLInputElement>("#q")?.value ?? "")
        .trim()
        .toLowerCase();
      const sectors = checked("sector");
      const beneficiaries = checked("beneficiaries");

      let shown = 0;
      for (const card of cards) {
        const cardSectors = (card.dataset.sectors ?? "").split(" ");
        const cardBeneficiaries = (card.dataset.beneficiaries ?? "").split(" ");
        const match =
          (!q || (card.dataset.name ?? "").includes(q)) &&
          (sectors.length === 0 ||
            sectors.some((s) => cardSectors.includes(s))) &&
          (beneficiaries.length === 0 ||
            beneficiaries.some((s) => cardBeneficiaries.includes(s)));
        card.hidden = !match;
        if (match) shown++;
      }

      summary =
        shown === total
          ? `Showing all ${total} nonprofits`
          : `Showing ${shown} of ${total} nonprofits`;
      countEl.textContent = summary;
      if (emptyEl) emptyEl.hidden = shown !== 0;

      // Keep the URL in sync so filtered views can be shared or bookmarked
      const params = new URLSearchParams();
      if (q) params.set("q", q);
      sectors.forEach((s) => params.append("sector", s));
      beneficiaries.forEach((s) => params.append("beneficiaries", s));
      const qs = params.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    };

    // Restore filters from the URL on load
    const initial = new URLSearchParams(location.search);
    const qInput = form.querySelector<HTMLInputElement>("#q");
    if (qInput) qInput.value = initial.get("q") ?? "";
    for (const name of ["sector", "beneficiaries"]) {
      const values = initial.getAll(name);
      form
        .querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)
        .forEach((i) => (i.checked = values.includes(i.value)));
    }

    form.addEventListener("input", apply);
    form.addEventListener("submit", (e) => e.preventDefault());
    form.addEventListener("reset", () => setTimeout(apply)); // run after the form clears

    // Grid / list toggle
    const viewButtons = form.querySelectorAll<HTMLButtonElement>(
      ".view-toggle button",
    );
    const setView = (view: string) => {
      results.dataset.view = view;
      viewButtons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.view === view)),
      );
      try {
        localStorage.setItem("view", view);
      } catch {}
    };
    viewButtons.forEach((b) =>
      b.addEventListener("click", () => setView(b.dataset.view!)),
    );
    try {
      const saved = localStorage.getItem("view");
      if (saved === "list" || saved === "grid") setView(saved);
    } catch {}

    apply();
  }
</script>
